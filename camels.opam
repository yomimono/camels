opam-version: "2.0"
maintainer: ["maintenance@identity-function.com"]
authors: ["yomimono"]
homepage: "https://github.com/yomimono/camels"
bug-reports: "https://github.com/yomimono/camels/issues"
dev-repo: "git+https://github.com/yomimono/camels.git"
license: "GPL-3.0-only"
tags: ["game"]

build: [
  ["dune" "build" "-p" name "-j" jobs]
]

depends: [
  "cmdliner" {>= "2.0.0"}
  "dune" {>= "1.8"}
  "fmt"
  "mirage-clock-unix" {>= "4.2.0"}
  "mirage-time-unix"
  "notty-community"
  "ocaml" {>= "4.07.0"}
  "ppx_deriving_yojson"
  "yojson"
]
synopsis: "A game about camels"
description: """
Experience the glamor and excitement of open-source project maintenance, combined with the blazing-fast action of an idle game, with the heart-pounding immersion of a cutting-edge terminal interface!  Features emoji/non-emoji mode, metrics, and save/restore functionality.  Live the life of adventure you've always dreamed of, with Camels Game - now future-compliant, with ✨ sparkles ✨!
"""
